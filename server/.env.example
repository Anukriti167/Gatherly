# Copy to server/.env and fill in. Never commit server/.env.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Public origin of the app (used for links in emails and CSRF origin checks).
# In development the Vite dev server (5173) proxies /api to this server.
APP_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/gatherly
# Separate database used by `npm test` — it is wiped by the test suite.
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/gatherly_test

# Number of reverse proxies in front of the app (GoDaddy hosting). "false" locally.
TRUST_PROXY=false

# Email — GoDaddy Titan Business Email (all outgoing mail: invitations, RSVPs, resets, contact form).
# Leave SMTP_HOST empty to print emails to the console instead of sending.
# If Titan rejects the login on smtp.titan.email, use smtpout.secureserver.net (GoDaddy's SMTP relay).
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=true
# Username is the FULL mailbox address. Password goes here only — never in code or the repo.
SMTP_USER=hello@yourdomain.com
SMTP_PASSWORD=
# The From address must be the same mailbox as SMTP_USER, or Titan will reject the message.
MAIL_FROM="Gatherly <hello@yourdomain.com>"
# Mailbox that receives contact-form submissions (FR-209).
CONTACT_INBOX=hello@yourdomain.com

RATE_LIMIT_ENABLED=true

# Emails sent per minute from the outgoing queue (bulk invitations are spread out).
EMAIL_RATE_PER_MINUTE=20

# Folder for uploaded photos (relative to server/). Must persist between deploys.
STORAGE_DIR=storage

# Anthropic Claude (optional AI features, later phase)
ANTHROPIC_API_KEY=
